# Copy to .env and fill values
PORT=3000

# GitHub personal access token (recommended for higher rate limits). Leave empty to use unauthenticated requests.
GITHUB_TOKEN=

# Meilisearch host and master key
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=masterKey

# Indexing settings
SYNC_INTERVAL_MS=3600000        # 1 hour
GITHUB_PER_PAGE=30
GITHUB_MAX_PAGES=5              # pages per query (adjust carefully)
SEED_QUERIES=music player,audio player,media player,mp3 player,music streaming,podcast player,video player,photo editor,todo app,notes app,chat app,calendar app,bookmark manager
